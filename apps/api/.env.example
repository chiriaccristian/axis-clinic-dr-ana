# Copy to .env for local development. Never commit real values.
HOST=localhost
PORT=3333

# Database (optional; without it the API starts with no database).
# Local Postgres:
# DATABASE_URL=postgres://postgres@localhost:5432/crm
# Cloud SQL with IAM auth (set by the deploy workflow on Cloud Run):
# CLOUD_SQL_INSTANCE=project:europe-west1:crm-db
# DB_NAME=crm
# DB_IAM_USER=api-runtime@project.iam

# Private bucket for photos, X-rays and consent documents.
# MEDIA_BUCKET=project-medical-files

# Public URL of the CRM app, used in invitation links.
# APP_URL=https://crm-test.drana.ro

# Email via Brevo (without these, invitation links are returned in the API
# response instead of being emailed).
# BREVO_API_KEY=
# MAIL_FROM=no-reply@drana.ro
# MAIL_FROM_NAME=Dr. Ana

# First super admin, created at startup only if none exists.
# BOOTSTRAP_ADMIN_USERNAME=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
